PORT=3000
JWT_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-at-least-32-characters
POSTGRES_DB=taskflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@localhost:5432/taskflow?schema=public
REDIS_URL=redis://localhost:6379
# Optional: the separately hosted frontend allowed to call this API.
# CORS_ORIGIN=http://localhost:5173
SEED_EMAIL=admin@example.com
SEED_PASSWORD=replace-with-a-strong-seed-password
SEED_NAME=TaskFlow Admin
