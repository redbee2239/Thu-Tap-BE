{
  "name": "taskflow-final",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run prisma:generate && tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "npm run prisma:generate && tsc",
    "lint": "npm run prisma:generate && tsc --noEmit",
    "test": "npm run prisma:generate && tsx --test --experimental-test-coverage --test-coverage-exclude=src/generated/** --test-coverage-exclude=tests/** tests/app.test.ts tests/auth.test.ts tests/schemas.test.ts tests/taskService.test.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "npm run prisma:generate && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.56.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "prisma": "^7.8.0",
    "redis": "^5.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
